# PayPilot Supabase Configuration
# Obtain these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Supabase Service Role Key (Server-Side Only - NEVER expose to browser)
# Required for authoritative server-side operations, webhook ledger, and approval records
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PayPilot PayPal Sandbox Configuration (Server-Side Only - Never expose to client)
# Obtain these from developer.paypal.com -> Dashboard -> Apps & Credentials (Sandbox)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# PayPal Webhook ID (obtained when registering http(s) endpoint in PayPal Developer Dashboard)
PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id

# PayPilot AI Copilot Configuration (Server-Side Only - Never expose to client)
# Obtain a Google Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Authentication & Session Security (Phase 3D)
SESSION_SECRET=your-secure-session-secret-at-least-32-bytes-long
PAYPILOT_DEMO_AUTH=true
